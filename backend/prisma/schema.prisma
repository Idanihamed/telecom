// Schéma Prisma — Amza Futur Telecom
// Phase 1 (fondations) : Auth/RBAC + Catégories + Marques + Produits.
// Phase 2 : Promotions/Réductions (§13-17 du cahier des charges).
// Phase 3 : Boutiques (§19, §5.8 du cahier des charges).
// Phase 4 : Actualités + Pages de contenu (§20, §22 du cahier des charges).
// Phase 5 : Formulaire de contact + Notifications internes (§23, §29 du cahier des charges).
// Phase 6 : Journal d'activité (§28 du cahier des charges).
// L'entité Order décrite dans le cahier des charges v2.0 sera ajoutée dans une phase
// suivante (module Commandes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum PromotionType {
  PERCENTAGE // ex. -20 %
  FIXED_AMOUNT // ex. -10 000 FCFA
  FIXED_PRICE // ex. prix promo fixé à 125 000 FCFA
}

// Statut piloté par l'administrateur. DRAFT et DISABLED sont des choix manuels ;
// lorsque le statut administratif est ACTIVE, le statut réellement affiché
// (Programmée / Active / Expirée) est calculé dynamiquement à partir des dates
// (voir computePromotionStatus) plutôt que stocké, pour éviter tout job de fond
// et toute désynchronisation (§14 : activation/expiration automatiques).
enum PromotionAdminStatus {
  DRAFT
  ACTIVE
  DISABLED
}

// Statut de publication partagé par les Actualités et les Pages de contenu (§20, §22).
enum PublishStatus {
  DRAFT
  PUBLISHED
}

// Cycle de vie d'un message de contact (§23) : Nouveau -> Lu -> Traité.
enum ContactMessageStatus {
  NOUVEAU
  LU
  TRAITE
}

// Types de notifications internes couverts en phase 5 (§29). "Nouvelle demande WhatsApp"
// sera ajouté lorsque le module Commandes/Demandes sera développé.
enum NotificationType {
  CONTACT_MESSAGE
  LOW_STOCK
  OUT_OF_STOCK
  PROMOTION_EXPIRING
  NEW_ORDER
}

// ---------- Authentification & permissions (RBAC dynamique) ----------

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ex. SUPER_ADMIN, GESTIONNAIRE, EDITEUR
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id       String           @id @default(cuid())
  resource String // ex. "products", "categories", "brands", "users"
  action   String // ex. "create", "read", "update", "delete", "publish"
  roles    RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  isActive      Boolean        @default(true)
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Catalogue ----------

model Category {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?
  image           String?
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  products        Product[]
  promotionLinks  PromotionCategory[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

model Product {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  sku               String             @unique
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?             @relation(fields: [brandId], references: [id])
  shortDescription  String?
  description       String?
  // Montants en FCFA : entiers, sans décimales (voir §15 du cahier des charges).
  price             Int
  promoPrice        Int?
  stock             Int                @default(0)
  lowStockThreshold Int                @default(5)
  warranty          String?
  isFeatured        Boolean            @default(false)
  status            ProductStatus      @default(DRAFT)
  images            ProductImage[]
  attributes        ProductAttribute[]
  promotionLinks    PromotionProduct[]
  orderItems        OrderItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isMain    Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_attributes")
}

// ---------- Promotions & réductions (§13-17 du cahier des charges) ----------

model Promotion {
  id           String                @id @default(cuid())
  name         String
  description  String?
  type         PromotionType
  // Pourcentage (0-100) pour PERCENTAGE, montant FCFA pour FIXED_AMOUNT,
  // prix final FCFA pour FIXED_PRICE.
  value        Int
  startsAt     DateTime
  endsAt       DateTime
  priority     Int                   @default(0)
  adminStatus  PromotionAdminStatus  @default(DRAFT)
  conditions   String?
  bannerTitle    String?
  bannerSubtitle String?
  bannerImage    String?
  products     PromotionProduct[]
  categories   PromotionCategory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([adminStatus])
  @@index([startsAt, endsAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionCategory {
  promotionId String
  categoryId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

// ---------- Boutiques (§19, §5.8 du cahier des charges) ----------

model Boutique {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  address       String
  phone         String?
  whatsapp      String?
  hours         String?
  description   String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  images        BoutiqueImage[]
  orders        Order[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive])
  @@map("boutiques")
}

model BoutiqueImage {
  id         String   @id @default(cuid())
  boutiqueId String
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  isMain     Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@index([boutiqueId])
  @@map("boutique_images")
}

// ---------- Actualités & Pages de contenu (§20, §22 du cahier des charges) ----------

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  image           String?
  // Contenu riche stocké en HTML (éditeur de texte riche côté admin, §20).
  content         String
  // Champ texte libre (pas de compte auteur lié en phase 4, voir README).
  author          String?
  // Catégorie éditoriale libre (pas de taxonomie dédiée en phase 4, voir README).
  category        String?
  // Date éditoriale affichée publiquement, distincte de createdAt/updatedAt.
  publishedAt     DateTime?
  status          PublishStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@map("articles")
}

model Page {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  // Contenu riche stocké en HTML (éditeur de texte riche côté admin, §22).
  content        String
  image          String?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@map("pages")
}

// ---------- Formulaire de contact & Notifications internes (§23, §29) ----------

model ContactMessage {
  id        String               @id @default(cuid())
  // Code court (ex. "A3K9F7Q2") communiqué au visiteur après l'envoi pour qu'il puisse
  // suivre sa demande sur /suivi sans créer de compte — le cuid de `id` est trop long/illisible
  // pour être recopié à la main (voir ContactMessagesService.generateReference).
  reference String               @unique
  name      String
  // Téléphone OU email, dans un seul champ texte (§23 ne demande qu'un seul champ).
  contact   String
  subject   String
  // Vide autorisé lorsque le message est uniquement vocal (voir voiceUrl) — accessibilité
  // pour les personnes ne sachant pas écrire (proposition produit, pas dans le §23 initial).
  message   String
  // Chemin "/uploads/..." d'un enregistrement vocal (webm/ogg/m4a), alternative ou
  // complément au texte. Au moins l'un des deux doit être renseigné (voir
  // ContactMessagesService.create).
  voiceUrl  String?
  status    ContactMessageStatus @default(NOUVEAU)
  // Réponse saisie par l'admin (§29 étendu), visible par le visiteur sur /suivi — seul canal
  // de réponse existant tant qu'aucun envoi d'email/SMS n'est en place (voir README).
  replyMessage   String?
  // Réponse vocale (même logique que voiceUrl pour l'envoi initial) : symétrie côté admin
  // pour répondre aux visiteurs ayant eux-mêmes envoyé un vocal. Au moins l'un des deux
  // (replyMessage / replyVoiceUrl) doit être renseigné — voir ContactMessagesService.setReply.
  replyVoiceUrl  String?
  repliedAt      DateTime?
  // Conservée uniquement à des fins de limitation de fréquence anti-spam (voir README) ;
  // jamais affichée à l'admin.
  ipAddress String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@map("contact_messages")
}

// ---------- Commandes (§ module Commandes, annoncé dans le README comme phase suivante) ----------

// Livrée -> terminale positive, Annulée -> terminale négative (restocke les produits, voir
// OrdersService.setStatus). Pas d'étape "Payée" : aucun moyen de paiement en ligne n'est
// intégré dans cette phase, la commande sert de pré-commande confirmée manuellement par
// l'admin (par téléphone/WhatsApp) avant préparation, comme pour les messages de contact.
enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
}

model Order {
  id     String @id @default(cuid())
  // Code court communiqué au client après l'envoi pour suivre sa commande sur /commandes/suivi
  // (même mécanisme que ContactMessage.reference — voir common/utils/reference.util.ts).
  reference String @unique

  // Pas de compte client (achat "invité", comme le formulaire de contact) : les coordonnées
  // sont saisies à chaque commande plutôt que liées à un modèle Customer séparé — cohérent
  // avec l'absence de compte utilisateur côté site public dans cette phase.
  customerName    String
  customerContact String
  customerAddress String?

  // Retrait en boutique optionnel (§5.8) ; onDelete SetNull plutôt que Cascade — supprimer une
  // boutique ne doit jamais supprimer l'historique des commandes qui y étaient rattachées.
  boutiqueId String?
  boutique   Boutique? @relation(fields: [boutiqueId], references: [id], onDelete: SetNull)

  notes  String?
  status OrderStatus @default(EN_ATTENTE)
  // Somme des sous-totaux de chaque ligne (voir OrderItem.subtotal), au moment de la commande —
  // ne recalcule jamais après coup même si les prix produits changent ensuite.
  totalAmount Int

  items OrderItem[]

  // Anti-spam par IP, même principe que ContactMessage.ipAddress (voir OrdersService.create).
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable + SetNull : la suppression d'un produit ne doit jamais casser l'historique
  // d'une commande passée — productName/unitPrice sont un instantané pris à la commande,
  // volontairement indépendant de l'état actuel du produit (dont le prix peut changer, ou
  // qui peut être dépublié/supprimé ensuite).
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  // Prix unitaire EFFECTIF (après promotion éventuelle) au moment de la commande, calculé
  // côté serveur (voir OrdersService.create) — jamais transmis par le client.
  unitPrice Int
  quantity  Int
  subtotal  Int

  @@index([orderId])
  @@map("order_items")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  // Lien profond vers l'admin (ex. /admin/messages, /admin/produits/xxx).
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead])
  @@map("notifications")
}

// ---------- Journal d'activité (§28) ----------

// Trace les actions de modification effectuées depuis le back-office (créations,
// modifications, suppressions, changements de statut...). Volontairement PAS de relation
// Prisma vers User (pas de @relation/onDelete) : userName/userEmail sont un instantané au
// moment de l'action, pour que l'historique reste lisible même si le compte est supprimé
// par la suite. Alimenté automatiquement par ActivityLogInterceptor (route générique),
// complété par un appel explicite pour les connexions (voir AuthService.login).
model ActivityLog {
  id          String   @id @default(cuid())
  // Nullable : conservé pour permettre, à l'avenir, des entrées générées par le système
  // lui-même (ex. tâche planifiée) sans utilisateur associé.
  userId      String?
  userName    String
  userEmail   String
  // Ex. CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, ACTIVATE, DISABLE, DUPLICATE, STOCK,
  // STATUS, UPLOAD, LOGIN — dérivée de la méthode HTTP et du dernier segment de route.
  action      String
  // Ressource concernée (ex. products, categories, promotions...), dérivée du chemin.
  resource    String
  resourceId  String?
  method      String
  path        String
  // Résumé lisible en français, prêt à afficher tel quel dans le back-office.
  description String
  createdAt   DateTime @default(now())

  @@index([resource])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ---------- Paramètres généraux (§24) ----------

// Ligne unique (singleton, id fixe "main") : réseaux sociaux affichés sur le site public
// et numéro WhatsApp de contact, modifiables depuis l'admin plutôt que codés en dur.
model Setting {
  id             String   @id @default("main")
  whatsappNumber String?
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  youtubeUrl     String?
  linkedinUrl    String?
  xUrl           String?
  // Visuels du hero de la page d'accueil (chemins /uploads/..., voir MediaModule) : uploadés
  // par l'admin depuis Paramètres plutôt que codés en dur, pour qu'Amza puisse les remplacer
  // par ses propres images sans intervention technique.
  heroImage1     String?
  heroImage2     String?
  updatedAt      DateTime @updatedAt

  @@map("settings")
}
