# Base de données
DATABASE_URL="postgresql://amza:amza_dev_pw@localhost:5432/amza_futur_telecom?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Serveur
PORT=3001
CORS_ORIGIN="http://localhost:3000"
# Cookies d'authentification (voir backend/src/auth/cookies.ts). Laisser "true" dès que l'API
# est servie en HTTPS (obligatoire pour SameSite=None, nécessaire en cross-origin front/API) —
# les navigateurs traitent "localhost" comme sécurisé même en HTTP, donc "true" fonctionne
# aussi tel quel en développement local. Ne mettre "false" que pour un déploiement HTTP interne
# exceptionnel (bascule alors sur SameSite=Lax).
COOKIE_SECURE="true"
# À définir UNIQUEMENT si l'API tourne derrière un reverse proxy/load balancer (Nginx,
# Cloudflare...), sinon laisser vide. Ex. "1" = un seul saut de proxy devant l'API (cas le
# plus courant). Voir le commentaire dans backend/src/main.ts avant de changer cette valeur :
# mal configurée, elle permet de falsifier l'IP vue par l'anti-spam / anti-brute-force.
TRUST_PROXY=

# Compte Super Admin créé par le seed initial
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_EMAIL="admin@amzafuturtelecom.com"
SEED_SUPERADMIN_PASSWORD="ChangeMoi123!"

# Upload des médias (stockage local pour la V1 ; migrable vers S3/Cloudinary plus tard)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=5

# Envoi d'email (confirmation de commande, accusé de réception de message de contact) — voir
# backend/src/mail/mail.service.ts. Laisser SMTP_HOST vide désactive l'envoi (les emails sont
# journalisés mais jamais réellement envoyés) : rien à faire pour développer/tester sans ça.
# Pour activer : créer un compte chez un fournisseur SMTP (Resend ou SendGrid ont un plan
# gratuit largement suffisant pour démarrer) et renseigner les 5 variables ci-dessous.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Amza Futur Telecom <no-reply@amzafuturtelecom.com>"

# Stockage des images (local par défaut ; Cloudinary si configuré) — voir
# backend/src/media/media.service.ts. STORAGE_DRIVER="cloudinary" + CLOUDINARY_URL active le
# stockage cloud ; sans ça, comportement actuel inchangé (disque local, dossier UPLOAD_DIR).
# Pour activer : créer un compte gratuit sur cloudinary.com, copier l'"CLOUDINARY_URL" affiché
# sur le tableau de bord (format cloudinary://<key>:<secret>@<cloud_name>).
STORAGE_DRIVER=local
CLOUDINARY_URL=
