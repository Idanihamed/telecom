NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Domaine public du site (sans slash final), utilisé pour générer des URLs absolues dans
# sitemap.xml/robots.txt. À remplacer par le vrai nom de domaine en production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Numéro WhatsApp principal (sans + ni espaces), utilisé par le bouton d'en-tête, l'accueil et
# la fiche produit. À distinguer des numéros WhatsApp par boutique, gérés depuis l'admin.
NEXT_PUBLIC_WHATSAPP_NUMBER=0000000000
